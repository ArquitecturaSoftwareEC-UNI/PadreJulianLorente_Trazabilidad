# ==============================================================================
# .gitignore — Sistema de Trazabilidad TI (COAC Padre Julián Lorente)
# ==============================================================================
# Este repositorio mantiene bajo control de versiones toda la documentación
# arquitectónica (docs/), las guías de agentes (AGENTS.md, CLAUDE.md) y la
# configuración de la skill PlantUML (.agents/skills/plantuml/, skills-lock.json).

# --- Archivos temporales y bloqueos de Office / LibreOffice ---
~$*.xlsx
~$*.xls
~$*.docx
~$*.doc
~$*.pptx
*.~lock.*

# --- Entornos y cachés de Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- Basura del Sistema Operativo ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini

# --- Archivos temporales de editores e IDEs ---
*.swp
*.swo
*.tmp
*.bak
*.orig
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Dependencias Node y artefactos de compilación futuros ---
node_modules/
.pnp
.pnp.js
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Variables de entorno y secretos locales ---
.env
.env.local
.env.*.local
!.env.example

# --- Binarios y herramientas locales ---
plantuml.jar

