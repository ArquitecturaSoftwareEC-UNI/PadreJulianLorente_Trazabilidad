  + calcularDiasHabiles() : Decimal
  + detectarAtrasoCertificacion() : Booleano
}

class RetornoFallo <<entity>> #FEF3C7 {
  - codigoRetorno : Texto
  - etapaOrigenRechazo : EtapaOficial
  - motivoRechazo : Texto
  - fechaHoraRetorno : FechaHora
