@startuml secuencia-cu02-emitir-alerta
autonumber "<b>[00]</b>"
skinparam dpi 150
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam defaultFontColor #0F172A
skinparam maxMessageSize 260
skinparam ParticipantPadding 16
skinparam BoxPadding 10
skinparam responseMessageBelowArrow true
skinparam padding 3

skinparam sequence {
  ArrowColor #334155
  ArrowThickness 1.5
  ArrowFontSize 13
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #E0F2FE
  GroupBackgroundColor #FFFFFF
  GroupBorderColor #64748B
  GroupHeaderFontSize 13
  GroupFontSize 13
  DividerBackgroundColor #E2E8F0
  DividerBorderColor #94A3B8
  DividerFontSize 15
  DividerFontStyle bold
  BoxBorderColor #CBD5E1
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
  FontSize 12
}
skinparam actor {
  BackgroundColor #0F172A
  BorderColor #0F172A
}

title CU-02 · Emitir alerta operativa\nEvaluación < 200 ms · Anti-spam 24 h · Despacho cifrado TLS ≥ 1.2 · Conmutación automática por fallo

' ----------------------------------------------------------------------------
' PARTICIPANTES (ECB)
' ----------------------------------------------------------------------------
control "Controlador\nSincronización\n(CU-01)" as Sync #FEF3C7
control "Controlador\nEmisión Alertas" as Ctrl #FEF3C7

box "Entidades del dominio" #E0F2FE
  entity "Alerta\nOperativa" as Alerta #EEF2FF
end box

box "Adaptadores de despacho (RNF-015, RNF-016)" #F8FAFC
  boundary "Adaptador\nMensajería" as AdMsg #F1F5F9
  boundary "Adaptador\nCorreo" as AdMail #F1F5F9
end box

box "Canales externos" #F1F5F9
  actor "Canal de Mensajería\nCorporativo" as Msg #475569
  actor "Servicio de Correo\nCorporativo" as Mail #475569
end box

' ----------------------------------------------------------------------------
== 1. Evaluación del umbral (< 200 ms · RNF-010) ==
Sync ->> Ctrl ++ : <<extend>> evaluarYEmitirAlerta(indicadoresConsolidados)
note left of Ctrl : Llamada asíncrona: CU-01 no espera\nrespuesta; el resultado queda en\nel estado de la AlertaOperativa
Ctrl -> Alerta ++ : evaluarReglasUmbralCritico(ocupacionHoras, diasCertificacion, retornos)
Alerta --> Ctrl -- : umbralSuperado = verdadero

break 1a · Falla del motor de reglas o tiempo excedido
  note over Ctrl, Alerta : FIN excepcional: se registra el error técnico sin emitir falsas alarmas
end

' ----------------------------------------------------------------------------
== 2. Redacción en lenguaje directo (RF-006) ==
Ctrl -> Alerta ++ : redactarMensajeEjecutivoClaro(responsable, moduloCore, valorExacto)
Alerta --> Ctrl -- : mensajeFormateado
note right of Alerta : Sin códigos crudos: desarrollador,\nmódulo financiero y valor exacto

' ----------------------------------------------------------------------------
== 3. Supresión anti-spam de 24 h (RF-023, RF-026, RNF-004) ==
critical Región crítica anti-spam
  Ctrl -> Alerta ++ : verificarSupresionAntiSpam24Horas(historialAlertas24h)
  Alerta --> Ctrl -- : esDuplicadaOAtendida

  break 3a · Alerta idéntica en 24 h o ya "atendida / en seguimiento" (CU-07)
    Ctrl -> Alerta ++ : registrarResultadoDespacho(canal = "NINGUNO", exitoso = falso, protocoloTLS = "N/A")
    Alerta --> Ctrl -- : SUPRIMIDA_ANTISPAM_24H
    note over Ctrl, Alerta : FIN alterno: se audita la supresión sin saturar canales
  end
end

' ----------------------------------------------------------------------------
== 4. Despacho cifrado por mensajería, con conmutación por fallo (RF-024, RF-025) ==
Ctrl -> AdMsg ++ : enviarMensajeAlerta(destinatarios, mensajeFormateado, protocolo = "TLS 1.2")
AdMsg -> Msg ++ : POST /webhook/alerts (cifrado ≥ TLS 1.2)

alt Entrega normal exitosa
  Msg --> AdMsg -- : 200 OK Delivered
  AdMsg --> Ctrl -- : entregaMensajeriaExitosa = verdadero
  Ctrl -> Alerta ++ : registrarResultadoDespacho(canal = "MENSAJERIA_CORPORATIVA", exitoso = verdadero)
  Alerta --> Ctrl -- : ENVIADA_MENSAJERIA
else 4a · Falla o rechazo del canal de mensajería (conmutación automática · RNF-016)
  Msg --> AdMsg -- : 503 Service Unavailable
  AdMsg --> Ctrl -- : entregaMensajeriaFallida = falso
  Ctrl -> AdMail ++ : enviarCorreoAlertaConmutacion(destinatarios, mensajeFormateado, protocolo = "TLS 1.3")
  AdMail -> Mail ++ : SMTP/TLS entregarNotificacionAlerta(asunto, cuerpo)
  Mail --> AdMail -- : 250 OK Message accepted
  AdMail --> Ctrl -- : entregaConmutadaExitosa = verdadero
  Ctrl -> Alerta ++ : registrarResultadoDespacho(canal = "CORREO_CONMUTADO", exitoso = verdadero)
  Alerta --> Ctrl -- : CONMUTADA_CORREO_POR_FALLO
end

' ----------------------------------------------------------------------------
== 5. Escalamiento adicional por correo (RF-025, RNF-015) ==
opt Más de 5 días en Certificación, Prioridad 1 o cambio de prioridad POA
  Ctrl -> AdMail ++ : enviarCorreoAlertaEscalamiento(destinatarios, mensajeFormateado, protocolo = "TLS 1.3")
  AdMail -> Mail ++ : SMTP/TLS entregarCorreoEscalamiento(asunto, cuerpo)
  Mail --> AdMail -- : 250 OK Message accepted
  AdMail --> Ctrl -- : entregaCorreoEscalada = verdadero
  Ctrl -> Alerta ++ : registrarResultadoDespacho(canal = "CORREO_ESCALAMIENTO", exitoso = verdadero)
  Alerta --> Ctrl -- : ESCALADA_CORREO
end

' ----------------------------------------------------------------------------
== 6. Excepción: caída simultánea de ambos canales (RNF-004) ==
break 5a · Caen a la vez la mensajería y el correo corporativo
  Ctrl -> Alerta ++ : registrarResultadoDespacho(canal = "FALLO_SIMULTANEO_EXTERNO", exitoso = falso, protocoloTLS = "N/A")
  Alerta --> Ctrl -- : ENTREGA_FALLIDA
  note right of Alerta
    Persistencia íntegra al 100%: ID único, fecha, categoría,
    destinatarios y estado ENTREGA_FALLIDA (visible en la vista única)
  end note
  note over Ctrl, Alerta : FIN excepcional: queda guardada para reintento y consulta en el tablero
end

deactivate Ctrl
note over Sync, Ctrl : Fin del proceso asíncrono: no hay respuesta hacia CU-01
@enduml
