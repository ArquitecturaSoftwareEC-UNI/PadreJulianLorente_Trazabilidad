@startuml secuencia-cu01a-extraccion-privacidad
autonumber "<b>[00]</b>"
skinparam dpi 150
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam defaultFontColor #0F172A
skinparam maxMessageSize 260
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam responseMessageBelowArrow true
skinparam padding 3

skinparam sequence {
  ArrowColor #334155
  ArrowThickness 1.5
  ArrowFontSize 13
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #E0F2FE
  GroupBackgroundColor #FFFFFF
  GroupBorderColor #64748B
  GroupHeaderFontSize 13
  GroupFontSize 13
  DividerBackgroundColor #E2E8F0
  DividerBorderColor #94A3B8
  DividerFontSize 15
  DividerFontStyle bold
  BoxBorderColor #CBD5E1
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
  FontSize 12
}
skinparam actor {
  BackgroundColor #0F172A
  BorderColor #0F172A
}

title CU-01 (1/2) · Sincronizar y consolidar trazabilidad: extracción concurrente y compuerta de privacidad\nCiclo ETL cada 5 min · Solo lectura · Resiliencia por snapshot · LOPDP 2021

' ----------------------------------------------------------------------------
' PARTICIPANTES (ECB): un borde por actor primario y uno por cada sistema externo
' ----------------------------------------------------------------------------
actor "Tiempo\n(CRON)" as Cron
boundary "Temporizador\nCron" as CronB #F1F5F9
control "Controlador\nSincronización" as Ctrl #FEF3C7

box "Entidades del dominio" #E0F2FE
  entity "Ciclo\nSincronización" as Ciclo #DCFCE7
  entity "Auditor\nCompuerta LOPDP" as Lopdp #DCFCE7
end box

box "Adaptadores de solo lectura (RNF-003, RNF-008, RNF-016)" #F8FAFC
  boundary "Adaptador\nRedmine" as BRed #F1F5F9
  boundary "Adaptador\nGLPI" as BGlpi #F1F5F9
  boundary "Adaptador\nGitLab" as BGit #F1F5F9
  boundary "Adaptador\nSonarQube" as BSonar #F1F5F9
end box

box "Fuentes externas" #F1F5F9
  actor "Redmine" as Red #475569
  actor "GLPI" as Glpi #475569
  actor "GitLab" as Git #475569
  actor "SonarQube" as Sonar #475569
end box

' ----------------------------------------------------------------------------
== 1. Disparo del ciclo (cada 5 min · RF-029) ==
Cron -> CronB ++ : dispararIntervaloPeriodico(minutos = 5)
CronB -> Ctrl ++ : ejecutarCicloSincronizacion(marcaTemporalDisparo)
Ctrl -> Ciclo ++ : iniciarCicloPeriodico(marcaTemporalDisparo)
Ciclo --> Ctrl -- : cicloIniciado

' ----------------------------------------------------------------------------
== 2. Extracción concurrente en solo lectura (timeout ≤ 10 s) ==
par Redmine (issues y POA)
  Ctrl -> BRed ++ : extraerDatosSoloLectura(credencialesLectura)
  BRed -> Red ++ : GET /issues.json
  Red --> BRed -- : datosRedmineCrudos
  BRed --> Ctrl -- : loteRedmine
else GLPI (tickets de soporte)
  Ctrl -> BGlpi ++ : extraerDatosSoloLectura(credencialesLectura)
  BGlpi -> Glpi ++ : GET /tickets.json
  Glpi --> BGlpi -- : datosGLPICrudos
  BGlpi --> Ctrl -- : loteGLPI
else GitLab (commits, MR y CI)
  Ctrl -> BGit ++ : extraerDatosSoloLectura(credencialesLectura)
  BGit -> Git ++ : GET /projects/repository
  Git --> BGit -- : datosGitLabCrudos
  BGit --> Ctrl -- : loteGitLab
else SonarQube (bugs y vulnerabilidades)
  Ctrl -> BSonar ++ : extraerDatosSoloLectura(credencialesLectura)
  BSonar -> Sonar ++ : GET /measures/component
  Sonar --> BSonar -- : datosSonarCrudos
  BSonar --> Ctrl -- : loteSonar
end

' ----------------------------------------------------------------------------
== 3. Resiliencia ante fallos de las fuentes (RNF-008) ==
break 2b · Caen todas las fuentes o rechazan las credenciales
  Ctrl -> Ciclo ++ : abortarPorFalloTotalFuentes(motivo)
  Ciclo --> Ctrl -- : vacio
  Ctrl --> CronB : notificarErrorCriticoAborto("Ciclo abortado por fallo total externo")
  note over Ctrl, Ciclo : FIN excepcional: no se sobreescriben los datos previos
end

opt 2a · Falla una sola fuente tras 3 reintentos (snapshot parcial)
  loop hasta 3 reintentos [tiempo de respuesta > 10 s o caída transitoria]
    Ctrl -> BRed ++ : reintentarExtraccion(credencialesLectura, intentoActual)
    BRed --> Ctrl -- : respuestaReintento
  end
  note right of BRed : Ejemplo con Redmine;\naplica a la fuente caída
  Ctrl -> Ciclo ++ : activarContingenciaSnapshotParcial(fuenteCaida, ultimoSnapshotValido)
  Ciclo --> Ctrl -- : SINCRONIZACION_PARCIAL_SNAPSHOT
  note right of Ctrl
    Se reutiliza el último snapshot válido.
    Prohibido reclasificar actividades
    como "sin trazabilidad".
  end note
end

' ----------------------------------------------------------------------------
== 4. Compuerta de privacidad LOPDP 2021 (RNF-017) ==
Ctrl -> Lopdp ++ : depurarYEnmascararPII(loteCrudo)
Lopdp --> Ctrl -- : textosDepurados
Ctrl -> Lopdp ++ : verificarCeroExposicionPII()
Lopdp --> Ctrl -- : cumpleCeroPII

break 3a · No se garantiza el 100% de enmascaramiento
  Ctrl -> Lopdp ++ : abortarLotePorRiesgoPII(motivoCritico)
  Lopdp --> Ctrl -- : vacio
  Ctrl --> CronB : notificarAbortoLotePorPrivacidad("100% de PII no garantizado")
  note over Ctrl, Lopdp : FIN excepcional: el lote se descarta antes de persistir
end

note over Ctrl, Sonar #D1FAE5
  **Continúa en CU-01 (2/2):** correlación, cálculo de indicadores y persistencia atómica
end note
@enduml
