@startuml secuencia-cu01-sincronizar-trazabilidad
autonumber "<b>[00]</b>"
skinparam roundcorner 8
skinparam shadowing false
skinparam padding 4
skinparam defaultFontName SansSerif
skinparam defaultFontSize 11
skinparam defaultFontColor #0F172A

skinparam actor {
  BackgroundColor #0F172A
  BorderColor #0F172A
  FontColor #0F172A
}

skinparam participant {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
}

skinparam sequence {
  ArrowColor #334155
  ArrowThickness 1.2
  LifeLineBorderColor #0284C7
  LifeLineBackgroundColor #E0F2FE
  GroupBackgroundColor #F8FAFC
  GroupBorderColor #64748B
  GroupHeaderFontColor #0F172A
  DividerBackgroundColor #F1F5F9
  DividerBorderColor #CBD5E1
}

title Diagrama de Secuencia UML 2.5.1 — CU-01: Sincronizar y consolidar trazabilidad e indicadores\n(Extracción Concurrente en Solo Lectura · LOPDP 2021 · Respaldo en Código · Idempotencia · Extensión CU-02)

' ==============================================================================
' PARTICIPANTES (PATRÓN ROBUSTEZ ECB: ACTORES, BOUNDARIES, CONTROL Y ENTIDADES)
' ==============================================================================
actor "Tiempo\n(Temporizador CRON)" as Cron #0F172A
boundary "TemporizadorCron\nBoundary" as CronBound #F1F5F9
control "ControladorSincronizacion\nTrazabilidad" as CtrlSync #FEF3C7

box "Adaptadores Externos en Modo Solo Lectura (RNF-003, RNF-008, RNF-016)" #F8FAFC
  boundary "Adaptador\nRedmine" as B_Redmine #F1F5F9
  boundary "Adaptador\nGLPI" as B_GLPI #F1F5F9
  boundary "Adaptador\nGitLab" as B_GitLab #F1F5F9
  boundary "Adaptador\nSonarQube" as B_Sonar #F1F5F9
end box

box "Plataformas Externas de Origen" #F1F5F9
  actor "Redmine\n(Issues/POA)" as ExtRedmine #475569
  actor "GLPI\n(Tickets Soporte)" as ExtGLPI #475569
  actor "GitLab\n(Commits/MR/CI)" as ExtGitLab #475569
  actor "SonarQube\n(Bugs/Vulnerabilidades)" as ExtSonar #475569
end box

box "Entidades del Dominio (Semana 4 — docs/uml/diagrama-clases.puml)" #E0F2FE
  entity "Ciclo\nSincronizacion" as E_Ciclo #DCFCE7
  entity "SnapshotFuente\nExterna" as E_Snap #DCFCE7
  entity "AuditorCompuerta\nLOPDP" as E_LOPDP #DCFCE7
  entity "TicketIncidente\nGLPI" as E_GLPI #E0F2FE
  entity "Evidencia\nCodigo" as E_Evid #E0F2FE
  entity "Actividad\nTrazable" as E_Act #E0F2FE
  entity "Asignacion\nActividad" as E_Asig #FEF3C7
  entity "Desarrollador" as E_Dev #FEF3C7
  entity "Epica\nPOA" as E_Epica #E0F2FE
  entity "ExpedienteModulo\nFinanciero" as E_Exp #E0F2FE
  entity "RegistroAuditoria\nCalculo" as E_Audit #DCFCE7
end box

control "ControladorEmision\nAlertas" as CtrlAlert #FEF3C7

' ==============================================================================
' 1. DISPARO PERIÓDICO DEL CICLO ETL (CADA 5 MINUTOS — RF-029)
' ==============================================================================
Cron -> CronBound : dispararIntervaloPeriodico(minutos = 5)
activate CronBound
CronBound -> CtrlSync : ejecutarCicloSincronizacion(marcaTemporalDisparo)
activate CtrlSync

CtrlSync -> E_Ciclo : iniciarCicloPeriodico(marcaTemporalDisparo)
activate E_Ciclo
E_Ciclo --> CtrlSync : cicloIniciado : CicloSincronizacion
deactivate E_Ciclo

' ==============================================================================
' 2. EXTRACCIÓN CONCURRENTE EN SOLO LECTURA Y MANEJO DE RESILIENCIA (RNF-003, RNF-008)
' ==============================================================================
par Extracción Concurrente en Solo Lectura (RNF-003, RNF-008, RNF-016)
  CtrlSync -> B_Redmine : extraerDatosSoloLectura(credencialesLectura)
  activate B_Redmine
  B_Redmine -> ExtRedmine : GET /issues.json (timeout <= 10s)
  ExtRedmine --> B_Redmine : datosRedmineCrudos : Lista<Texto>
  B_Redmine --> CtrlSync : loteRedmine : SnapshotFuenteExterna
  deactivate B_Redmine
else
  CtrlSync -> B_GLPI : extraerDatosSoloLectura(credencialesLectura)
  activate B_GLPI
  B_GLPI -> ExtGLPI : GET /tickets.json (timeout <= 10s)
  ExtGLPI --> B_GLPI : datosGLPICrudos : Lista<Texto>
  B_GLPI --> CtrlSync : loteGLPI : SnapshotFuenteExterna
  deactivate B_GLPI
else
  CtrlSync -> B_GitLab : extraerDatosSoloLectura(credencialesLectura)
  activate B_GitLab
  B_GitLab -> ExtGitLab : GET /projects/repository (timeout <= 10s)
  ExtGitLab --> B_GitLab : datosGitLabCrudos : Lista<Texto>
  B_GitLab --> CtrlSync : loteGitLab : SnapshotFuenteExterna
  deactivate B_GitLab
else
  CtrlSync -> B_Sonar : extraerDatosSoloLectura(credencialesLectura)
  activate B_Sonar
  B_Sonar -> ExtSonar : GET /measures/component (timeout <= 10s)
  ExtSonar --> B_Sonar : datosSonarCrudos : Lista<Texto>
  B_Sonar --> CtrlSync : loteSonar : SnapshotFuenteExterna
  deactivate B_Sonar
end

' --- Reintentos y Manejo de Snapshot Parcial (Flujo Alterno 2a y Excepción 2b) ---
loop hasta 3 reintentos automáticos [tiempoRespuesta > 10 s o caída transitoria]
  CtrlSync -> B_Redmine : reintentarExtraccion(credencialesLectura, intentoActual)
  activate B_Redmine
  B_Redmine --> CtrlSync : respuestaReintento
  deactivate B_Redmine
end

alt 2a: Falla persistente de una única fuente externa tras 3 reintentos (Snapshot Parcial RNF-008)
  CtrlSync -> E_Snap : validarTimeoutYReintentos(segundosConsumidos = 10.0, intentos = 3)
  activate E_Snap
  E_Snap --> CtrlSync : esInalcanzable = verdadero
  deactivate E_Snap
  CtrlSync -> E_Snap : marcarComoSnapshotContingencia(codigoCiclo)
  activate E_Snap
  E_Snap --> CtrlSync : snapshotContingencia : SnapshotFuenteExterna
  deactivate E_Snap
  CtrlSync -> E_Ciclo : activarContingenciaSnapshotParcial(fuenteCaida, snapshotContingencia)
  activate E_Ciclo
  E_Ciclo --> CtrlSync : estadoParcial = SINCRONIZACION_PARCIAL_SNAPSHOT
  deactivate E_Ciclo
  note right of CtrlSync : Se reutiliza último snapshot consolidado válido.\nProhibido reclasificar actividades como 'sin trazabilidad'.
else 2b [break]: Indisponibilidad total de todas las fuentes o credenciales rechazadas (RNF-003, RNF-008)
  CtrlSync -> E_Ciclo : abortarPorFalloTotalFuentes(motivo = "Indisponibilidad total tras reintentos")
  activate E_Ciclo
  E_Ciclo --> CtrlSync : vacio
  deactivate E_Ciclo
  CtrlSync --> CronBound : notificarErrorCriticoAborto("Ciclo abortado por fallo total externo")
  note over CtrlSync : Fin excepcional del ciclo (X) sin sobreescribir datos previos
end

' ==============================================================================
' 3. COMPUERTA OBLIGATORIA LOPDP 2021 (PRIVACIDAD POR DISEÑO — RNF-017)
' ==============================================================================
CtrlSync -> E_LOPDP : depurarYEnmascararPII(loteCrudoTextos)
activate E_LOPDP
E_LOPDP --> CtrlSync : textosDepurados : Lista<Texto>
deactivate E_LOPDP

CtrlSync -> E_LOPDP : verificarCeroExposicionPII()
activate E_LOPDP
E_LOPDP --> CtrlSync : cumpleCeroPII : Booleano
deactivate E_LOPDP

alt 3a [break]: Fallo en la compuerta de enmascaramiento LOPDP 2021 (RNF-017)
  CtrlSync -> E_LOPDP : abortarLotePorRiesgoPII(motivoCritico = "Detección de cédulas/cuentas sin enmascarar")
  activate E_LOPDP
  E_LOPDP --> CtrlSync : vacio
  deactivate E_LOPDP
  CtrlSync --> CronBound : notificarAbortoLotePorPrivacidad("100% de PII no garantizado")
  note over CtrlSync : Fin excepcional (X): Lote descartado antes de persistir
end

' ==============================================================================
' 4–7. TRANSFORMACIÓN, CORRELACIÓN Y VALIDACIÓN DE CÓDIGO (RF-012..RF-038)
' ==============================================================================
' --- Cruce tolerante GLPI #ID en Redmine (Flujo Alterno 5a) ---
opt 5a: Coincidencia tolerante ante errores tipográficos en GLPI #ID (RF-013)
  CtrlSync -> E_GLPI : normalizarReferenciaDigitada(textoCrudoRedmine)
  activate E_GLPI
  E_GLPI --> CtrlSync : referenciaLimpia : Texto
  deactivate E_GLPI
  CtrlSync -> E_Act : enlazarTicketGLPITolerante(referenciaLimpia, ticket)
  activate E_Act
  E_Act --> CtrlSync : enlazadoExitoso = verdadero
  deactivate E_Act
end

' --- Detección de retorno por fallo hacia desarrollo (Flujo Alterno 5b) ---
opt 5b: Detección de retorno por rechazo en Certificación o CI/CD (RF-015, RF-005)
  CtrlSync -> E_Act : registrarRetornoPorFallo(etapaOrigen = CERTIFICACION, motivoRechazo = "Rechazo pruebas QA")
  activate E_Act
  E_Act --> CtrlSync : totalRetornos = contadorRetornosPorFallo
  deactivate E_Act
  note right of E_Act : Penaliza -10 pts en componente de calidad
end

' --- Segregación de actividades sin trazabilidad (Flujos Alternos 6a y 6b) ---
alt 6a: Trabajo en código en GitLab sin tarea en Redmine (RF-021)
  CtrlSync -> E_Act : clasificarActividadSinTrazabilidad(origen = GITLAB)
  activate E_Act
  E_Act --> CtrlSync : tipo = TRABAJO_CODIGO_SIN_TRAZABILIDAD_PLANIFICADA
  deactivate E_Act
else 6b: Incidente en GLPI sin petición espejo en Redmine (RF-022, RF-003)
  CtrlSync -> E_Act : clasificarActividadSinTrazabilidad(origen = GLPI)
  activate E_Act
  E_Act --> CtrlSync : tipo = INCIDENTE_SOPORTE_SIN_TRAZABILIDAD_DESARROLLO
  deactivate E_Act
  CtrlSync -> E_GLPI : calcularEsfuerzoSoporteAutomatico()
  activate E_GLPI
  E_GLPI --> CtrlSync : horasSoporte (4h estándar / 8h crítico core)
  deactivate E_GLPI
end

' --- Verificación de respaldo real en código (Flujo Alterno 7a y RF-038) ---
CtrlSync -> E_Evid : contabilizarCommitsTipados(mensajesCommit)
activate E_Evid
E_Evid --> CtrlSync : conteoCommits (feat, fix, test, refactor)
deactivate E_Evid

alt 7a: Validación de umbrales de evidencia en código (>25% y 100% — RF-038)
  CtrlSync -> E_Evid : validarRequisitosAvance25Porciento()
  activate E_Evid
  E_Evid --> CtrlSync : tieneRamaYCommitsTipados : Booleano
  deactivate E_Evid
  CtrlSync -> E_Evid : validarRequisitosCierre100Porciento()
  activate E_Evid
  E_Evid --> CtrlSync : tieneMRAprobadoYPipelineExitoso : Booleano
  deactivate E_Evid
  CtrlSync -> E_Act : verificarRespaldoAvanceEnCodigo(evidencia)
  activate E_Act
  E_Act --> CtrlSync : avanceRealVerificado : Decimal
  deactivate E_Act
end

' --- Divergencia entre autor y asignado + QA cruzado (Flujo Alterno 7b y RF-017) ---
opt 7b: Verificación de autor real vs asignado y QA cruzado (RF-017, RF-003)
  CtrlSync -> E_Asig : verificarDivergenciaAutoria(asignadoRedmine, autorGitLab)
  activate E_Asig
  E_Asig --> CtrlSync : existeDivergencia : Booleano
  deactivate E_Asig
  CtrlSync -> E_Asig : obtenerEsfuerzoPorRol()
  activate E_Asig
  E_Asig --> CtrlSync : horasRol (2h por revisión QA cruzado)
  deactivate E_Asig
end

' --- Fórmulas de negocio: Etapas, Carga 40h, Semáforo y Eficiencia 70/30 ---
CtrlSync -> E_Act : normalizarEtapaOficial(estadoOrigen, tieneMRAprobado, pipelineCICDExitoso)
activate E_Act
E_Act --> CtrlSync : etapaNormalizada : EtapaOficialFlujo
deactivate E_Act

CtrlSync -> E_Dev : calcularCargaLaboralEfectiva()
activate E_Dev
E_Dev --> CtrlSync : horasEfectivasSemanales : Decimal
deactivate E_Dev

CtrlSync -> E_Dev : determinarSemaforoOcupacion()
activate E_Dev
E_Dev --> CtrlSync : semaforo : SemaforoCapacidad (VERDE/AMARILLO/ROJO)
deactivate E_Dev

CtrlSync -> E_Dev : calcularEficienciaPonderada(retornos, hallazgosCriticos)
activate E_Dev
E_Dev --> CtrlSync : eficiencia : Decimal (70% avance + 30% calidad)
deactivate E_Dev

CtrlSync -> E_Epica : consolidarAvanceRealVsPlanificado()
activate E_Epica
E_Epica --> CtrlSync : desviacionAvancePuntos : Decimal
deactivate E_Epica

CtrlSync -> E_Exp : unificarExpedienteCronologico(actividadesModulo)
activate E_Exp
E_Exp --> CtrlSync : expedienteConsolidado : ExpedienteModuloFinanciero
deactivate E_Exp

' ==============================================================================
' 8. PERSISTENCIA ATÓMICA E IDEMPOTENTE CON RASTRO AUDITABLE (RNF-001, RNF-009)
' ==============================================================================
critical Región Crítica Atómica e Idempotente (0% Duplicados — RNF-009, RNF-001)
  CtrlSync -> E_Audit : sellarRegistroInmutable(entradasInmutables, resultadoCalculado)
  activate E_Audit
  E_Audit --> CtrlSync : registroSellado : RegistroAuditoriaCalculo
  deactivate E_Audit
  note right of E_Audit : Retención inmutable >= 12 meses (RNF-001)

  CtrlSync -> E_Ciclo : consolidarLoteIdempotente(expedientesConsolidados)
  activate E_Ciclo
  E_Ciclo --> CtrlSync : consolidacionExitosa : Booleano
  deactivate E_Ciclo

  alt 8a [break]: Conflicto o inconsistencia irrecuperable en persistencia
    CtrlSync -> E_Ciclo : revertirLotePorConflicto(detalleError = "Violación de atomicidad/llave")
    activate E_Ciclo
    E_Ciclo --> CtrlSync : vacio
    deactivate E_Ciclo
    CtrlSync --> CronBound : notificarFalloConsolidacion("Lote revertido íntegramente")
    note over CtrlSync : Fin excepcional (X) sin alterar la línea base vigente
  end
end

' ==============================================================================
' EXTENSIÓN CONDICIONAL HACIA CU-02: EMITIR ALERTA OPERATIVA (DESACOPLADO)
' ==============================================================================
opt Superación de Umbral Crítico (Carga > 40h, Certificación > 5d, Retorno, P1 — RF-031)
  CtrlSync ->> CtrlAlert : <<extend>> evaluarYEmitirAlerta(indicadoresConsolidados)
  activate CtrlAlert
  note right of CtrlAlert : Despacho asíncrono en segundo plano (RNF-016)\nNo bloquea el término del ciclo ETL
  deactivate CtrlAlert
end

CtrlSync --> CronBound : cicloCompletadoExitosamente(resumenConsolidado)
deactivate CtrlSync
CronBound --> Cron : notificarCicloFinalizado(intervaloSiguienteEn = 5 min)
deactivate CronBound
@enduml
