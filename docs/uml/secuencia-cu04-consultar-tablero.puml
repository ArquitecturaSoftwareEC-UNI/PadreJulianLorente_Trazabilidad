@startuml secuencia-cu04-consultar-tablero
autonumber "<b>[00]</b>"
skinparam roundcorner 8
skinparam shadowing false
skinparam padding 4
skinparam defaultFontName SansSerif
skinparam defaultFontSize 11
skinparam defaultFontColor #0F172A

skinparam actor {
  BackgroundColor #0F172A
  BorderColor #0F172A
  FontColor #0F172A
}

skinparam participant {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
}

skinparam sequence {
  ArrowColor #334155
  ArrowThickness 1.2
  LifeLineBorderColor #0284C7
  LifeLineBackgroundColor #E0F2FE
  GroupBackgroundColor #F8FAFC
  GroupBorderColor #64748B
  GroupHeaderFontColor #0F172A
  DividerBackgroundColor #F1F5F9
  DividerBorderColor #CBD5E1
}

title Diagrama de Secuencia UML 2.5.1 — CU-04: Consultar tablero de control\n(Vista Única Compartida · Carga Inicial <= 2 s p95 · Refresco Incremental < 1 s · Cierre Limpio < 200 ms)

' ==============================================================================
' PARTICIPANTES (PATRÓN ROBUSTEZ ECB: ACTOR, BOUNDARY, CONTROL Y ENTIDADES)
' ==============================================================================
actor "Jefe de Desarrollo / PMO\n(Sesión Institucional CU-03)" as Directivo #0F172A
boundary "PanelTableroControl\nBoundary" as PanelBound #F1F5F9
control "ControladorConsulta\nTablero" as CtrlDash #FEF3C7

box "Entidades del Dominio (Semana 4 — docs/uml/diagrama-clases.puml)" #E0F2FE
  entity "Sesion\nInstitucional" as E_Sesion #EEF2FF
  entity "ExpedienteModulo\nFinanciero" as E_Exp #E0F2FE
  entity "Desarrollador" as E_Dev #FEF3C7
  entity "Epica\nPOA" as E_Epica #E0F2FE
  entity "SnapshotFuente\nExterna" as E_Snap #DCFCE7
  entity "Alerta\nOperativa" as E_Alert #EEF2FF
end box

' ==============================================================================
' 1. INGRESO A LA VISTA ÚNICA COMPARTIDA (HTTPS TLS 1.3 — RF-030, RF-032, RNF-013)
' ==============================================================================
Directivo -> PanelBound : solicitarAccesoTablero(identificadorSesion)
activate PanelBound
PanelBound -> CtrlDash : consultarEstadoConsolidado(identificadorSesion)
activate CtrlDash

' ==============================================================================
' 2. RECUPERACIÓN DESACOPLADA Y RESILIENCIA (RNF-008, RNF-014)
' ==============================================================================
alt 2c [break]: Indisponibilidad del almacenamiento consolidado o sesión caducada
  CtrlDash --> PanelBound : notificarSesionInvalida("Sesión expirada o almacenamiento inaccesible")
  PanelBound --> Directivo : desplegarMensajeReingreso("Por favor autentíquese nuevamente")
  note over CtrlDash : Fin excepcional (X): Termina sin exponer trazas técnicas internas
else 2b [break]: Ausencia total de sincronización inicial en el sistema
  CtrlDash --> PanelBound : notificarAusenciaConsolidacionInicial("Sin ejecuciones previas de CU-01")
  PanelBound --> Directivo : desplegarAvisoInformativo("Tablero en espera del primer ciclo de sincronización")
  note over CtrlDash : Fin excepcional (X): Evita mostrar indicadores vacíos engañosos
else 2a: Consulta con reporte de fallo externo parcial en CU-01 (Continuidad RNF-008)
  CtrlDash -> E_Snap : verificarFrescuraDatos(instanteConsulta)
  activate E_Snap
  E_Snap --> CtrlDash : antiguedadDatos : Duracion
  deactivate E_Snap
  note right of CtrlDash : Entrega el 100% del último snapshot consolidado válido\ncon su marca temporal de última sincronización exitosa (RNF-008)
else Flujo Básico Normal: Lectura sobre almacenamiento consolidado en <= 2 s (p95 — RNF-014)
  CtrlDash -> E_Exp : calcularMapaCalorModulo()
  activate E_Exp
  E_Exp --> CtrlDash : indiceCalorCritico : Decimal
  deactivate E_Exp

  CtrlDash -> E_Exp : detectarCuellosDeBotellaEmbudo()
  activate E_Exp
  E_Exp --> CtrlDash : cuellosBotella : Lista<EtapaOficialFlujo>
  deactivate E_Exp
  note right of E_Exp : Resalta en rojo etapas críticas (>35% tareas activas,\n>5d Certificación o >2d Despliegue — RF-036, RNF-005)

  CtrlDash -> E_Dev : obtenerResumenTarjetaOperativa()
  activate E_Dev
  E_Dev --> CtrlDash : resumenTarjetas : Mapa<Texto, Texto>
  deactivate E_Dev
  note right of E_Dev : Semáforo base 40h, tareas POA vs GLPI,\npuntos Fibonacci 2/5/13 y QA cruzado (RF-035)

  CtrlDash -> E_Epica : consolidarAvanceRealVsPlanificado()
  activate E_Epica
  E_Epica --> CtrlDash : comparativaAvance : Decimal
  deactivate E_Epica
end

' ==============================================================================
' 3–4. PRESENTACIÓN EJECUTIVA Y VISUALIZACIÓN INMEDIATA (RNF-002, RNF-005, RNF-012)
' ==============================================================================
CtrlDash --> PanelBound : entregarDatosTableroConsolidado(metricas, semaforos, embudo, mapasCalor)
deactivate CtrlDash
PanelBound --> Directivo : desplegarTableroControl(tiempoRespuesta <= 2 s p95)
note over Directivo : Vista única adaptada a resoluciones 1920x1080, 768x1024 o 360x640 (RNF-012)\nIdentificación de desviaciones críticas en rojo en <= 5 s (RNF-005)

' ==============================================================================
' 5. REFRESCO INCREMENTAL PERIÓDICO CADA 5 MINUTOS (RF-034, RNF-014)
' ==============================================================================
loop Mientras la sesión permanezca activa en pantalla [cada 5 minutos tras fin de CU-01]
  CtrlDash -> CtrlDash : detectarVariacionesConsolidadas(ultimoCicloConsolidado)
  activate CtrlDash
  deactivate CtrlDash
  CtrlDash --> PanelBound : transmitirCambiosIncrementales(elementosCambiados) [latencia < 1 s]
  PanelBound --> Directivo : refrescarElementosCambiadosSinRecargar()
end

' ==============================================================================
' EXTENSIÓN CONDICIONAL HACIA CU-05: FILTRAR INDICADORES DEL TABLERO
' ==============================================================================
opt Paso 6: Requerimiento de [análisis focalizado] por el directivo
  Directivo -> PanelBound : solicitarSegmentacionTablero()
  note right of PanelBound : Habilita el punto de extensión <<extend>> CU-05:\nFiltrar indicadores del tablero (RF-008)
end

' ==============================================================================
' FLUJO ALTERNO 5a: CIERRE DETERMINISTA Y LIBERACIÓN DE RECURSOS (< 200 ms — RNF-011)
' ==============================================================================
opt 5a: Cierre voluntario de sesión o expiración por inactividad
  Directivo -> PanelBound : cerrarSesionInstitucional()
  PanelBound -> CtrlDash : solicitarCierreYLiberacionRecursos()
  activate CtrlDash
  CtrlDash -> E_Sesion : confirmarBitacoraYLiberarRecursos()
  activate E_Sesion
  E_Sesion --> CtrlDash : recursosLiberados = verdadero (tiempo <= 200 ms)
  deactivate E_Sesion
  CtrlDash --> PanelBound : confirmacionRecursosLiberados(0 conexiones huérfanas)
  deactivate CtrlDash
  PanelBound --> Directivo : sesionFinalizada()
  deactivate PanelBound
end
@enduml
