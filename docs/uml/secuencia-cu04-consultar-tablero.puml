@startuml secuencia-cu04-consultar-tablero
autonumber "<b>[00]</b>"
skinparam dpi 150
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam defaultFontColor #0F172A
skinparam maxMessageSize 260
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam responseMessageBelowArrow true
skinparam padding 3

skinparam sequence {
  ArrowColor #334155
  ArrowThickness 1.5
  ArrowFontSize 13
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #E0F2FE
  GroupBackgroundColor #FFFFFF
  GroupBorderColor #64748B
  GroupHeaderFontSize 13
  GroupFontSize 13
  DividerBackgroundColor #E2E8F0
  DividerBorderColor #94A3B8
  DividerFontSize 15
  DividerFontStyle bold
  BoxBorderColor #CBD5E1
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
  FontSize 12
}
skinparam actor {
  BackgroundColor #0F172A
  BorderColor #0F172A
}

title CU-04 · Consultar tablero de control\nVista única compartida · Carga inicial ≤ 2 s (p95) · Refresco incremental < 1 s · Cierre limpio ≤ 200 ms

' ----------------------------------------------------------------------------
' PARTICIPANTES (ECB)
' ----------------------------------------------------------------------------
actor "Jefe de Desarrollo\n/ PMO" as Dir
boundary "Panel\nTablero de Control" as Panel #F1F5F9
control "Controlador\nConsulta Tablero" as Ctrl #FEF3C7
control "Controlador\nSincronización\n(CU-01)" as Sync #FEF3C7
control "Controlador\nFiltrado Tablero\n(CU-05)" as CtrlF #FEF3C7

box "Entidades del dominio" #E0F2FE
  entity "Sesión\nInstitucional" as Ses #EEF2FF
  entity "Snapshot\nFuente Externa" as Snap #DCFCE7
  entity "Expediente\nMódulo Financiero" as Exp #E0F2FE
  entity "Desarrollador" as Dev #FEF3C7
  entity "Épica\nPOA" as Epica #E0F2FE
end box

' ----------------------------------------------------------------------------
== 1. Ingreso a la vista única (HTTPS TLS 1.3 · RF-030, RF-032, RNF-013) ==
Dir -> Panel ++ : solicitarAccesoTablero(identificadorSesion)
Panel -> Ctrl ++ : consultarEstadoConsolidado(identificadorSesion)

' ----------------------------------------------------------------------------
== 2. Recuperación del estado consolidado (≤ 2 s p95 · RNF-014) ==
alt 2c · Sesión institucional caducada
  Ctrl --> Panel : notificarSesionInvalida("Sesión expirada")
  deactivate Ctrl
  Panel --> Dir : desplegarMensajeReingreso("Por favor autentíquese nuevamente")
  deactivate Panel
  note over Ctrl, Panel : FIN excepcional: sin exponer trazas técnicas internas
else 2d · Almacenamiento consolidado inaccesible (RNF-008)
  Ctrl --> Panel : notificarAlmacenamientoNoDisponible("Servicio temporalmente no disponible")
  deactivate Ctrl
  Panel --> Dir : desplegarAvisoServicioNoDisponible("Intente nuevamente en unos minutos")
  deactivate Panel
  note over Ctrl, Panel : FIN excepcional: no se culpa a la sesión de un fallo de infraestructura
else 2b · Ausencia total de sincronización inicial
  Ctrl --> Panel : notificarAusenciaConsolidacionInicial("Sin ejecuciones previas de CU-01")
  deactivate Ctrl
  Panel --> Dir : desplegarAvisoInformativo("Tablero en espera del primer ciclo de sincronización")
  deactivate Panel
  note over Ctrl, Panel : FIN excepcional: evita mostrar indicadores vacíos engañosos
else Datos consolidados disponibles
  opt 2a · CU-01 reportó un fallo externo parcial (RNF-008)
    Ctrl -> Snap ++ : verificarFrescuraDatos(instanteConsulta)
    Snap --> Ctrl -- : antiguedadDatos
    note right of Snap : Se entrega el último snapshot válido\ncon su marca temporal de sincronización
  end

  Ctrl -> Exp ++ : calcularMapaCalorModulo()
  Exp --> Ctrl -- : indiceCalorCritico
  Ctrl -> Exp ++ : detectarCuellosDeBotellaEmbudo()
  Exp --> Ctrl -- : cuellosBotella
  note right of Exp : Rojo si > 35% de tareas activas,\n> 5 d en Certificación o > 2 d en Despliegue
  Ctrl -> Dev ++ : obtenerResumenTarjetaOperativa()
  Dev --> Ctrl -- : resumenTarjetas
  note right of Dev : Semáforo 40 h, tareas POA vs GLPI,\npuntos Fibonacci y QA cruzado
  Ctrl -> Epica ++ : consolidarAvanceRealVsPlanificado()
  Epica --> Ctrl -- : comparativaAvance

  Ctrl --> Panel : entregarDatosTableroConsolidado(metricas, semaforos, embudo, mapasCalor)
  deactivate Ctrl
  Panel --> Dir : desplegarTableroControl(tiempoRespuesta ≤ 2 s p95)
  deactivate Panel
  note over Dir : Desviaciones críticas en rojo en ≤ 5 s (RNF-005)\nResoluciones 1920×1080, 768×1024 y 360×640 (RNF-012)
end

' ----------------------------------------------------------------------------
== 3. Refresco incremental: el cierre de cada ciclo de CU-01 empuja los cambios (RF-034) ==
loop Mientras la sesión permanezca abierta [cada 5 min, tras finalizar CU-01]
  Sync ->> Ctrl ++ : notificarCicloConsolidado(elementosCambiados)
  Ctrl ->> Panel ++ : transmitirCambiosIncrementales(elementosCambiados) [latencia < 1 s]
  Panel ->> Dir : refrescarElementosCambiadosSinRecargar()
  deactivate Panel
  deactivate Ctrl
end

' ----------------------------------------------------------------------------
== 4. Acciones opcionales del directivo ==
opt Requiere análisis focalizado (extensión CU-05 · RF-008)
  Dir -> Panel ++ : solicitarSegmentacionTablero()
  Panel -> CtrlF ++ : activarDimensionesSegmentacion()
  CtrlF --> Panel -- : desplegarDimensionesDisponibles(desarrollador, modulo, etapa, fechas) [< 300 ms]
  Panel --> Dir -- : presentarControlesSegmentacion()
  note right of CtrlF : Continúa en secuencia-cu05-filtrar-tablero.puml
end

opt 5a · Cierre voluntario de sesión o expiración por inactividad
  Dir -> Panel ++ : cerrarSesionInstitucional()
  Panel -> Ctrl ++ : solicitarCierreYLiberacionRecursos()
  Ctrl -> Ses ++ : confirmarBitacoraYLiberarRecursos()
  Ses --> Ctrl -- : recursosLiberados = verdadero (≤ 200 ms · RNF-011)
  Ctrl --> Panel -- : confirmacionRecursosLiberados(0 conexiones huérfanas)
  Panel --> Dir -- : sesionFinalizada()
end
@enduml
