@startuml mapa-de-capacidades
!pragma layout smetana
top to bottom direction
skinparam dpi 150
skinparam nodesep 22
skinparam ranksep 30
skinparam padding 12

<style>
document {
  BackgroundColor #FFFFFF
}
title {
  FontName SansSerif
  FontSize 16
  FontStyle bold
  FontColor #1F4E78
  HorizontalAlignment center
}
footer {
  FontName SansSerif
  FontSize 10
  FontColor #475569
  HorizontalAlignment center
}
rectangle {
  LineColor #1F4E78
  LineThickness 1.8
  BackgroundColor #F8FAFC
  FontColor #1F4E78
  FontStyle bold
  FontSize 12
  RoundCorner 10
  HorizontalAlignment center
}
card {
  FontColor #0F172A
  FontSize 10
  LineThickness 1.5
  RoundCorner 10
  HorizontalAlignment center
}
</style>

title Mapa de Capacidades Institucionales TI (Business Capability Map — TOGAF ADM)\nSistema de Trazabilidad TI — COAC Padre Julián Lorente

' === NIVEL 1: CAPACIDADES ESTRATÉGICAS Y DE GOBIERNO TI / PMO ===
rectangle "NIVEL 1 — CAPACIDADES ESTRATÉGICAS Y DE GOBIERNO TI / PMO" as N1 #EFF6FF {
  card C11 #DBEAFE;line:1D4ED8;text:0F172A [
    <b>Gobierno de Portafolio</b>
    <b>POA / PETI</b>
    Seguimiento estratégico por
    los 6 módulos del core
    financiero (RF-012, RF-018).
  ]

  card C12 #DBEAFE;line:1D4ED8;text:0F172A [
    <b>Gestión de Capacidad</b>
    <b>y Carga Laboral (40 h)</b>
    Balanceo semanal por
    desarrollador con semáforos
    Verde / Amarillo / Rojo (RF-002).
  ]

  card C13 #DBEAFE;line:1D4ED8;text:0F172A [
    <b>Control de Desempeño y</b>
    <b>Reporte Trimestral (CU-08)</b>
    Consolidado ejecutivo de
    POA/PETI, REQ, INI.TI, GLPI
    y certificaciones (RF-040).
  ]

  card C14 #DBEAFE;line:1D4ED8;text:0F172A [
    <b>Auditoría Causal y</b>
    <b>Transparencia (CU-06)</b>
    Investigación de causa raíz en
    < 10 s sobre expediente completo
    sin acceso de desarrollo (RF-010).
  ]
}

' === NIVEL 2: CAPACIDADES CORE DE TRAZABILIDAD TI (DIFERENCIADORAS) ===
rectangle "NIVEL 2 — CAPACIDADES CORE DE TRAZABILIDAD TI (DIFERENCIADORAS)" as N2 #FFFBEB {
  card C21 #FEF3C7;line:D97706;text:0F172A [
    <b>Ingesta Multiplataforma</b>
    <b>en Solo Lectura (CU-01)</b>
    Extracción cada 5 min desde
    Redmine, GLPI, GitLab y SonarQube
    con 0 escrituras en origen (RNF-003).
  ]

  card C22 #FEF3C7;line:D97706;text:0F172A [
    <b>Correlación Jerárquica</b>
    <b>de 4 Niveles</b>
    Enlace Épica → Spec → Tarea → Código
    con cruce tolerante GLPI y detección
    de trabajo huérfano (RF-021/022).
  ]

  card C23 #FEF3C7;line:D97706;text:0F172A [
    <b>Validación de Avance Real</b>
    <b>Respaldado en Código</b>
    Contraste estricto de reporte
    > 25 % y 100 % frente a commits,
    MR y CI/CD + QA cruzado (RF-038).
  ]

  card C24 #FEF3C7;line:D97706;text:0F172A [
    <b>Cálculo Fibonacci y</b>
    <b>Eficiencia 70 / 30</b>
    Conversión Baja=2, Media=5, Alta=13;
    eficiencia 70 % avance + 30 % calidad
    (-10 retorno, -5 SonarQube).
  ]

  card C25 #FEF3C7;line:D97706;text:0F172A [
    <b>Embudo de 5 Etapas y</b>
    <b>Cuellos de Botella</b>
    Normalización en 5 etapas oficiales
    resaltando congestión > 35 % o
    > 5 días en Certificación (RF-036).
  ]

  card C26 #FEF3C7;line:D97706;text:0F172A [
    <b>Detección de Desviaciones</b>
    <b>y Alertas Anti-Spam 24 h</b>
    Reglas en < 200 ms (CU-02),
    supresión 24 h, atención CU-07
    y escalamiento a Correo TLS.
  ]
}

' === NIVEL 3: CAPACIDADES DE SOPORTE, SEGURIDAD Y PLATAFORMA ===
rectangle "NIVEL 3 — CAPACIDADES DE SOPORTE, SEGURIDAD Y PLATAFORMA" as N3 #ECFDF5 {
  card C31 #DCFCE7;line:15803D;text:0F172A [
    <b>Protección de Datos</b>
    <b>LOPDP Ecuador 2021</b>
    Compuerta obligatoria 100 % libre
    de PII de socios antes de persistir;
    retención ≥ 24 meses (RNF-017).
  ]

  card C32 #DCFCE7;line:15803D;text:0F172A [
    <b>Identidad y Acceso Web</b>
    <b>Único sin VPN (CU-03)</b>
    Autenticación LDAP/OIDC vía DMZ
    HTTPS TLS 1.3; misma vista de solo
    lectura en escritorio y móvil.
  ]

  card C33 #DCFCE7;line:15803D;text:0F172A [
    <b>Resiliencia Operativa</b>
    <b>y Mitigación SPOF</b>
    Timeout 10 s + 3 reintentos,
    snapshot parcial ante caídas y
    PostgreSQL Hot Standby + VIP HA.
  ]

  card C34 #DCFCE7;line:15803D;text:0F172A [
    <b>Auditoría Matemática</b>
    <b>Inmutable (12 meses)</b>
    Sellado de fórmulas/entradas para
    reproducibilidad 100 % e idempotencia
    con 0 % duplicados (RNF-001/009).
  ]

  card C35 #DCFCE7;line:15803D;text:0F172A [
    <b>Consultas de Alto Desempeño</b>
    <b>y Portabilidad OCI</b>
    Carga ≤ 2 s p95, filtros ≤ 400 ms,
    refresco < 1 s y artefactos Docker
    desacoplados por configuración.
  ]
}

C11 -[hidden]right-> C12
C12 -[hidden]right-> C13
C13 -[hidden]right-> C14

C21 -[hidden]right-> C22
C22 -[hidden]right-> C23
C24 -[hidden]right-> C25
C25 -[hidden]right-> C26
C21 -[hidden]down-> C24
C22 -[hidden]down-> C25
C23 -[hidden]down-> C26

C31 -[hidden]right-> C32
C32 -[hidden]right-> C33
C34 -[hidden]right-> C35
C31 -[hidden]down-> C34
C32 -[hidden]down-> C35

C12 -[hidden]down-> C22
C25 -[hidden]down-> C32

footer Mapa de Capacidades TOGAF ADM — Cobertura integral de las 6 Épicas (EP-01..EP-06), 40 RF, 18 RNF y CU-01..CU-08
@enduml
