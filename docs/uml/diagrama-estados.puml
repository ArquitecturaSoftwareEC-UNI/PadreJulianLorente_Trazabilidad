@startuml diagrama-estados
!pragma layout smetana
top to bottom direction
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 30
skinparam padding 6
skinparam Shadowing false

<style>
document {
  BackgroundColor #FFFFFF
}
title {
  FontName SansSerif
  FontSize 15
  FontStyle bold
  FontColor #1F4E78
  HorizontalAlignment center
}
footer {
  FontName SansSerif
  FontSize 10
  FontColor #475569
  HorizontalAlignment center
}
stateDiagram {
  state {
    BackgroundColor #E0F2FE
    BorderColor #0284C7
    LineThickness 1.5
    FontColor #0F172A
    FontName SansSerif
    FontSize 10
    RoundCorner 10
  }
  .normal_stage {
    BackgroundColor #E0F2FE
    BorderColor #0284C7
    FontColor #0F172A
  }
  .warning_bottleneck {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontColor #451A03
  }
  .error_return {
    BackgroundColor #FEE2E2
    BorderColor #DC2626
    FontColor #7F1D1D
  }
  .success_closed {
    BackgroundColor #DCFCE7
    BorderColor #15803D
    FontColor #052E16
  }
  .suppressed_state {
    BackgroundColor #F1F5F9
    BorderColor #475569
    FontColor #1E293B
  }
  arrow {
    LineColor #334155
    LineThickness 1.4
    FontColor #1E293B
    FontSize 9
  }
  note {
    BackgroundColor #FFFBEB
    BorderColor #D97706
    FontColor #78350F
    FontSize 9
  }
}
</style>

title Vista Lógica (Semana 4) — Diagrama de Estados UML 2.5.1 de Entidades con Ciclo de Vida Crítico\nSistema de Trazabilidad TI — COAC Padre Julián Lorente (CicloSincronizacion · ActividadTrazable · AlertaOperativa)

' ==============================================================================
' MÁQUINA DE ESTADOS 1: CICLO DE SINCRONIZACIÓN ETL (CU-01)
' ==============================================================================
state "1. Ciclo de Vida de CicloSincronizacion (CU-01 — Ejecución Periódica Cada 5 Minutos)" as M1_SYNC {

  state "ProgramadoEnEspera" as S_WAIT <<normal_stage>> {
    S_WAIT : entry / verificarCredencialesSoloLectura() [RNF-003]
    S_WAIT : do / aguardar intervalo CRON = 5 min (RF-029)
  }

  state "ExtrayendoEnSoloLectura" as S_EXT <<normal_stage>> {
    S_EXT : entry / iniciarCicloPeriodico(marcaTemporal)
    S_EXT : do / consultar Redmine, GLPI, GitLab, SonarQube (timeout <= 10 s, 0..3 reintentos) [RNF-008]
  }

  state "SincronizacionParcialConSnapshot" as S_PARCIAL <<warning_bottleneck>> {
    S_PARCIAL : entry / activarContingenciaSnapshotParcial(fuenteCaida, ultimoSnapshotValido)
    S_PARCIAL : do / conservar marca temporal previa y prohibir degradación falsa de trazabilidad [Flujo 2a]
  }

  state "AbortadoPorFalloTotalFuentes" as S_ABORT_2B <<error_return>> {
    S_ABORT_2B : entry / abortarPorFalloTotalFuentes(motivo) [Excepción 2b]
    S_ABORT_2B : exit / preservar 100% de datos consolidados previos
  }

  state "ValidandoCompuertaLOPDP" as S_LOPDP <<normal_stage>> {
    S_LOPDP : entry / depurarYEnmascararPII(loteCrudo)
    S_LOPDP : do / verificarCeroExposicionPII() sobre cédulas, cuentas y correos [RNF-017]
  }

  state "AbortadoPorRiesgoPII" as S_ABORT_3A <<error_return>> {
    S_ABORT_3A : entry / abortarLotePorRiesgoPII(motivoCritico) [Excepción 3a]
    S_ABORT_3A : do / descartar lote en memoria antes de persistir
  }

  state "CorrelacionandoYCalculando" as S_CALC <<normal_stage>> {
    S_CALC : entry / enlazar 4 niveles + cruce tolerante GLPI #ID (5a) + segregar RF-021/022 (6a/6b)
    S_CALC : do / calcular Fibonacci (2/5/13), carga base 40h, avance real (7a) y eficiencia 70/30 [RF-001..005]
  }

  state "ConsolidandoIdempotente" as S_LOAD <<normal_stage>> {
    S_LOAD : entry / consolidarLoteIdempotente(expedientes) con llaveNaturalCompuesta [RNF-009]
    S_LOAD : do / sellarRegistroInmutable() por >= 12 meses [RNF-001]
  }

  state "RevertidoPorConflictoIntegridad" as S_ROLLBACK_8A <<error_return>> {
    S_ROLLBACK_8A : entry / revertirLotePorConflicto(detalleError) [Excepción 8a]
    S_ROLLBACK_8A : do / rollback transaccional completo sin alterar línea vigente
  }

  state "ConsolidadoExitoso" as S_OK_SYNC <<success_closed>> {
    S_OK_SYNC : entry / actualizar proyecciones de lectura (CU-04 <= 2 s, refresco < 1 s)
    S_OK_SYNC : exit / si [umbral crítico superado] disparar <<extend>> CU-02
  }

  [*] --> S_WAIT : Inicialización del temporizador (RF-029)
  S_WAIT --> S_EXT : Disparo Tiempo (CRON 5 min) [RF-029]
  S_EXT --> S_LOPDP : [4 fuentes responden <= 10 s]
  S_EXT --> S_PARCIAL : [1..3 fuentes caen tras 3 reintentos] / Flujo 2a
  S_PARCIAL --> S_LOPDP : [snapshot previo válido reutilizado]
  S_EXT --> S_ABORT_2B : [4 fuentes caen o credenciales inválidas] / Excepción 2b
  S_LOPDP --> S_CALC : [compuertaAprobada == verdadero (100% sin PII)]
  S_LOPDP --> S_ABORT_3A : [detección de PII residual (< 100%)] / Excepción 3a
  S_CALC --> S_LOAD : [indicadores y 5 etapas calculados]
  S_LOAD --> S_OK_SYNC : [0% duplicados verificado]
  S_LOAD --> S_ROLLBACK_8A : [conflicto de persistencia] / Excepción 8a
  S_ABORT_2B --> [*]
  S_ABORT_3A --> [*]
  S_ROLLBACK_8A --> [*]
  S_OK_SYNC --> [*]
}

' ==============================================================================
' MÁQUINA DE ESTADOS 2: ACTIVIDAD TRAZABLE EN LAS 5 ETAPAS OFICIALES (RF-019, RF-015, RF-036, RF-038)
' ==============================================================================
state "2. Ciclo de Vida de ActividadTrazable en las 5 Etapas Oficiales (RF-019, RF-015, RF-036, RF-038)" as M2_ETAPAS {

  state "SegregadaSinTrazabilidad" as S_HUERFANA <<warning_bottleneck>> {
    S_HUERFANA : entry / clasificarActividadSinTrazabilidad() [RF-021 o RF-022]
    S_HUERFANA : do / sumar esfuerzo a carga semanal del Desarrollador y exponer en CU-06 (2a)
  }

  state "1. Análisis" as E1_ANALISIS <<normal_stage>> {
    E1_ANALISIS : entry / asignar complejidadFibonacci (2, 5 o 13 pts) y horasEstimadas [RF-001]
    E1_ANALISIS : do / computar horas en capacidad semanal base 40h [RF-003]
  }

  state "2. Desarrollo (En Curso)" as E2_DESARROLLO <<normal_stage>> {
    E2_DESARROLLO : entry / verificarRespaldoAvanceEnCodigo(evidencia)
    E2_DESARROLLO : do / exigir rama activa + commits tipados (feat/fix/test/refactor) si reporta > 25% [RF-038]
  }

  state "DesarrolloConBrechaEvidencia" as E2_BRECHA <<warning_bottleneck>> {
    E2_BRECHA : entry / marcar tieneBrechaEvidencia = verdadero [Flujo Alterno 7a]
    E2_BRECHA : do / usar avance verificable en código y exponer discrepancia en CU-06 (3a)
  }

  state "3. Certificación (QA / Pruebas)" as E3_CERT <<normal_stage>> {
    E3_CERT : entry / capturar revisor de QA cruzado (+2h / 1pt) y hallazgos SonarQube (-5 pts) [RF-003, RF-005]
    E3_CERT : do / monitorear diasHabilesEnEtapaActual
  }

  state "CertificacionCuelloDeBotella" as E3_CUELLO <<error_return>> {
    E3_CUELLO : entry / marcar esCuelloDeBotella = verdadero [diasHabiles > 5] (RF-036)
    E3_CUELLO : do / resaltar en rojo en embudo (<= 5 s) y disparar alerta por correo (RF-025, RF-031)
  }

  state "4. Despliegue" as E4_DESPLIEGUE <<normal_stage>> {
    E4_DESPLIEGUE : entry / validarRequisitosCierre100Porciento() [MR aprobado + CI/CD exitoso] (RF-038)
    E4_DESPLIEGUE : do / alertar cuello de botella si permanece > 2 días (RF-036)
  }

  state "5. Estabilización" as E5_ESTAB <<success_closed>> {
    E5_ESTAB : entry / consolidar avanceRealVerificado = 100% y eficiencia final
    E5_ESTAB : do / contabilizar certificación a tiempo vs. atrasada para CU-08 (RF-040)
  }

  [*] --> E1_ANALISIS : Petición registrada en línea base (RF-012, RF-033)
  [*] --> S_HUERFANA : Actividad huérfana en GitLab (6a) o GLPI (6b)
  E1_ANALISIS --> E2_DESARROLLO : Inicio de construcción [rama / asignación activa]
  E2_DESARROLLO --> E2_BRECHA : [porcentajeReportado > 25% SIN rama/commits tipados] / Flujo 7a (RF-038)
  E2_BRECHA --> E2_DESARROLLO : [commits tipados feat/fix/test/refactor verificados]
  E2_DESARROLLO --> E3_CERT : Apertura de Merge Request y pase a pruebas
  E3_CERT --> E3_CUELLO : [diasHabilesEnEtapaActual > 5 días hábiles] (RF-031, RF-036)
  E3_CERT --> E2_DESARROLLO : <b>Retorno por fallo (Flujo 5b)</b>\n[rechazo QA o fallo CI/CD] / contadorRetornos++ (-10 pts calidad RF-015, RF-005)
  E3_CUELLO --> E2_DESARROLLO : <b>Retorno por fallo (Flujo 5b)</b>\n[rechazo en Certificación] / contadorRetornos++ (-10 pts calidad RF-015)
  E3_CERT --> E4_DESPLIEGUE : [MR aprobado Y pipeline CI/CD exitoso] (RF-038)
  E3_CUELLO --> E4_DESPLIEGUE : [MR aprobado Y pipeline CI/CD exitoso tras atraso]
  E4_DESPLIEGUE --> E5_ESTAB : Pase a producción verificado
  S_HUERFANA --> E2_DESARROLLO : [Enlace posterior con tarea #ID en Redmine]
  E5_ESTAB --> [*]
}

' ==============================================================================
' MÁQUINA DE ESTADOS 3: ALERTA OPERATIVA Y SU GESTIÓN (CU-02 Y CU-07)
' ==============================================================================
state "3. Ciclo de Vida de AlertaOperativa (CU-02 Emisión Anti-Spam y CU-07 Gestión)" as M3_ALERTA {

  state "EvaluandoUmbralCritico" as A_EVAL <<normal_stage>> {
    A_EVAL : entry / evaluarReglasUmbralCritico() en < 200 ms [RNF-010]
    A_EVAL : do / redactarMensajeEjecutivoClaro() sin códigos crudos [RF-006]
  }

  state "AbortadaErrorEvaluacion" as A_ERR_1A <<error_return>> {
    A_ERR_1A : entry / registrar fallo técnico en bitácora (> 200 ms o inconsistencia) [Excepción 1a]
  }

  state "VerificandoAntiSpam24h" as A_SPAM <<normal_stage>> {
    A_SPAM : entry / verificarSupresionAntiSpam24Horas(historialReciente) [RF-023, RF-026]
  }

  state "SuprimidaAntiSpam24h" as A_SUPRIMIDA <<suppressed_state>> {
    A_SUPRIMIDA : entry / bloquear reenvío duplicado (< 24h o en seguimiento sin agravamiento) [Flujo 3a]
    A_SUPRIMIDA : do / persistir constancia de supresión en bitácora (RNF-004)
  }

  state "DespachandoCanalesCifrados" as A_DESPACHO <<normal_stage>> {
    A_DESPACHO : entry / transmitir sobre TLS >= 1.2 al Canal de Mensajería Corporativo [RF-024, RNF-015]
    A_DESPACHO : do / si [> 5 días Certificación | Prioridad 1 | cambio prioridad] enviar también por Correo [RF-025]
  }

  state "ConmutadaACorreoPorFalloChat" as A_FAILOVER <<warning_bottleneck>> {
    A_FAILOVER : entry / activar Servicio de Correo Corporativo por rechazo en Mensajería [Flujo 4a, RF-025]
    A_FAILOVER : do / registrar fallo en chat y entrega efectiva por correo (RNF-004)
  }

  state "EntregaExternaFallida" as A_FALLIDA_5A <<error_return>> {
    A_FALLIDA_5A : entry / persistir 100% del evento con estado ENTREGA_FALLIDA [Excepción 5a, RNF-004]
    A_FALLIDA_5A : do / mantener visible en tablero único para reintento y gestión
  }

  state "ActivaNotificadaEnTablero" as A_ACTIVA <<warning_bottleneck>> {
    A_ACTIVA : entry / registrarResultadoDespacho() con ID único, fecha/hora y destinatarios [RNF-004]
    A_ACTIVA : do / exhibir priorizada por criticidad (< 10 s) en CU-04 y CU-06 [RNF-007]
  }

  state "EnSeguimientoJefatura" as A_SEGUIMIENTO <<normal_stage>> {
    A_SEGUIMIENTO : entry / marcarEstadoGestionJefatura(EN_SEGUIMIENTO, usuario, fecha) [CU-07, RF-026]
    A_SEGUIMIENTO : do / detener recordatorios externos mientras no exista agravamiento
  }

  state "AtendidaCerrada" as A_ATENDIDA <<success_closed>> {
    A_ATENDIDA : entry / marcarEstadoGestionJefatura(ATENDIDA, usuario, fecha) [CU-07, RF-026]
    A_ATENDIDA : exit / confirmarBitacoraYLiberarRecursos() en < 200 ms al cerrar sesión [RF-027, RNF-011]
  }

  [*] --> A_EVAL : Condición [umbral crítico superado] al cierre de CU-01
  A_EVAL --> A_ERR_1A : [fallo interno o > 200 ms] / Excepción 1a
  A_EVAL --> A_SPAM : [regla evaluada < 200 ms y mensaje redactado]
  A_SPAM --> A_SUPRIMIDA : [idéntica < 24h O ya Atendida/EnSeguimiento sin agravamiento] / Flujo 3a
  A_SPAM --> A_DESPACHO : [alerta nueva o con agravamiento de severidad]
  A_DESPACHO --> A_ACTIVA : [confirmación en Canal de Mensajería (y Correo si aplica)]
  A_DESPACHO --> A_FAILOVER : [fallo en Canal de Mensajería] / Flujo Alterno 4a
  A_FAILOVER --> A_ACTIVA : [entrega exitosa por Servicio de Correo Corporativo]
  A_DESPACHO --> A_FALLIDA_5A : [caída simultánea de Mensajería y Correo] / Excepción 5a
  A_FAILOVER --> A_FALLIDA_5A : [fallo también en Servicio de Correo Corporativo] / Excepción 5a
  A_FALLIDA_5A --> A_ACTIVA : [visibilidad inmediata en vista única consolidada]
  A_ACTIVA --> A_SEGUIMIENTO : Jefe de Desarrollo / PMO marca «En seguimiento» (CU-07)
  A_ACTIVA --> A_ATENDIDA : Jefe de Desarrollo / PMO marca «Atendida» (CU-07)
  A_SEGUIMIENTO --> A_ATENDIDA : Jefe de Desarrollo / PMO cierra como «Atendida» (CU-07)
  A_SEGUIMIENTO --> A_DESPACHO : [nuevo agravamiento detectado en ciclo posterior]
  A_ERR_1A --> [*]
  A_SUPRIMIDA --> [*]
  A_ATENDIDA --> [*]
}

M1_SYNC -[hidden]right-> M2_ETAPAS
M2_ETAPAS -[hidden]right-> M3_ALERTA

footer Vista Lógica (Semana 4) — Diagrama de Estados derivado de los Flujos Básicos, Alternos y de Excepción de docs/especificaciones-casos-de-uso.md
@enduml
