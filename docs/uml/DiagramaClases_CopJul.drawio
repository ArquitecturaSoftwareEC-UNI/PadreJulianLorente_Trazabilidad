        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml diagrama-clases\n!pragma layout smetana\ntop to bottom direction\nskinparam dpi 150\nskinparam classAttributeIconSize 0\nskinparam roundcorner 8\nskinparam shadowing false\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 11\nskinparam nodesep 42\nskinparam ranksep 60\n\n&lt;style&gt;\ndocument {\n  BackgroundColor #FFFFFF\n}\ntitle {\n  FontName SansSerif\n  FontSize 16\n  FontStyle bold\n  FontColor #1F4E78\n}\nfooter {\n  FontName SansSerif\n  FontSize 10\n  FontColor #475569\n}\nclass {\n  RoundCorner 8\n  LineThickness 1.4\n  BorderColor #1F4E78\n  FontColor #0F172A\n}\nenum {\n  BackgroundColor #F8FAFC\n  BorderColor #475569\n  FontColor #0F172A\n  RoundCorner 8\n  LineThickness 1.2\n}\narrow {\n  LineColor #334155\n  LineThickness 1.3\n  FontColor #0F172A\n  FontSize 10\n}\n&lt;/style&gt;\n\ntitle Vista Lógica — Diagrama de Clases del Dominio UML 2.5.1\\nSistema de Trazabilidad TI — COAC Padre Julián Lorente (16 Clases «entity» · 40 Operaciones · 10 Enumeraciones · CU-01 a CU-08)\n\n&#39; ============================================================================\n&#39; CLASES DEL DOMINIO (UML 2.5.1 — SIN CONTENEDORES DE PAQUETES)\n&#39; ============================================================================\nclass ModuloFinanciero &lt;&lt;entity&gt;&gt; #E0F2FE {\n  - codigoModulo : Texto\n  - nombreCore : ModuloCoreFinanciero [1..6]\n  - /totalTareasActivas : Entero\n  - /tieneCuelloBotella : Booleano\n  --\n  + consolidarPorModulo() : ExpedienteTrazabilidad\n  + evaluarCuelloBotellaEmbudo() : Booleano\n}\n\nclass ProyectoPOA &lt;&lt;entity&gt;&gt; #E0F2FE {\n  - codigoPOA : Texto\n  - nombreProyecto : Texto\n  - prioridadEstrategica : Entero\n  - /avancePlanificadoVsReal : Decimal\n  --\n  + calcularDesviacionAvance() : Decimal\n  + registrarCambioPrioridad(nueva : Entero) : Booleano\n}\n\nclass HistoriaSpec &lt;&lt;entity&gt;&gt; #E0F2FE {\n  - codigoSpec : Texto\n  - tipoRequerimiento : TipoEspecificacion\n  - horasEstimadasBase : Decimal\n  - fechaCompromiso : FechaHora\n  - /porcentajeCumplimiento : Decimal\n  --\n  + desglosarTareasPlanificadas() : Lista&lt;TareaIssue&gt;\n  + calcularAvancePonderado() : Decimal\n}\n\nclass TareaIssue &lt;&lt;entity&gt;&gt; #E0F2FE {\n  - codigoIssue : Texto\n  - complejidad : NivelComplejidad\n  - etapaActual : EtapaOficial\n  - porcentajeReportado : Decimal\n  - /avanceRealVerificado : Decimal\n  --\n  + validarRespaldoEnCodigo() : Decimal\n  + cambiarEtapaOficial() : EtapaOficial\n  + enlazarIncidenteGLPI() : Booleano\n}\n\nclass Desarrollador &lt;&lt;entity&gt;&gt; #DCFCE7 {\n  - codigoDesarrollador : Texto\n  - nombreCompleto : Texto\n  - capacidadBaseSemanal : Decimal = 40.0\n  - /horasEfectivasSemana : Decimal\n  - /semaforo : NivelSemaforo\n  --\n  + calcularCargaLaboral40h() : Decimal\n  + determinarSemaforoCapacidad() : NivelSemaforo\n  + auditarDivergenciaAutoria() : Booleano\n}\n\nclass ActividadCodigo &lt;&lt;entity&gt;&gt; #DCFCE7 {\n  - ramaActiva : Texto\n  - codigoMergeRequest : Texto\n  - tipoCommit : TipoCommit\n  - mrAprobado : Booleano\n  - pipelineCICDExitoso : Booleano\n  --\n  + verificarCommitsTipados25PorCiento() : Booleano\n  + validarCierreCienPorCiento() : Booleano\n  + clasificarCodigoSinTrazabilidad() : Booleano\n}\n\nclass IncidenteSoporte &lt;&lt;entity&gt;&gt; #DCFCE7 {\n  - codigoGLPI : Texto\n  - esCriticoCoreFinanciero : Booleano\n  - /horasCargaEstandar : Decimal\n  - /puntosFibonacci : Entero\n  - /tieneTareaEspejoRedmine : Booleano\n  --\n  + normalizarReferenciaGLPI() : Texto\n  + asignarEsfuerzoAutomatico() : Decimal\n  + clasificarSoporteSinTrazabilidad() : Booleano\n}\n\nclass ReporteCalidad &lt;&lt;entity&gt;&gt; #DCFCE7 {\n  - codigoAnalisis : Texto\n  - bugsCriticosAbiertos : Entero\n  - vulnerabilidadesAbiertas : Entero\n  - fechaInspeccion : FechaHora\n  - /puntosPenalizacion : Decimal\n  --\n  + calcularPenalizacionCalidad() : Decimal\n  + verificarCompuertaCalidad() : Booleano\n}\n\nclass ExpedienteTrazabilidad &lt;&lt;entity&gt;&gt; #FEF3C7 {\n  - codigoExpediente : Texto\n  - llaveNaturalCompuesta : Texto\n  - estadoSincronizacion : EstadoSincronizacion\n  - anonimizadoLOPDP : Booleano = verdadero\n  - /tieneBrechaEvidencia : Booleano\n  --\n  + unificarHistorial4Niveles() : ExpedienteTrazabilidad\n  + verificarCompuertaLOPDP() : Booleano\n  + reconstruirCausaRaiz() : ExpedienteTrazabilidad\n}\n\nclass HitoEtapa &lt;&lt;entity&gt;&gt; #FEF3C7 {\n  - etapaOficial : EtapaOficial [1..5]\n  - fechaHoraIngreso : FechaHora\n  - fechaHoraSalida : FechaHora [0..1]\n  - /diasHabilesPermanencia : Decimal\n  - /esCuelloDeBotella : Booleano\n  --\n  + calcularDiasHabiles() : Decimal\n  + detectarAtrasoCertificacion() : Booleano\n}\n\nclass RetornoFallo &lt;&lt;entity&gt;&gt; #FEF3C7 {\n  - codigoRetorno : Texto\n  - etapaOrigenRechazo : EtapaOficial\n  - motivoRechazo : Texto\n  - fechaHoraRetorno : FechaHora\n  - penalizacionCalidad : Decimal = -10.0\n  --\n  + registrarRetornoADesarrollo() : Entero\n  + aplicarDescuentoDiezPuntos() : Decimal\n}\n\nclass IndicadorDesempeno &lt;&lt;entity&gt;&gt; #FEF3C7 {\n  - codigoIndicador : Texto\n  - pesoAvanceReal : Decimal = 70.0\n  - pesoCalidadTecnica : Decimal = 30.0\n  - /puntajeEficiencia : Decimal\n  - huellaInmutable12Meses : Texto\n  --\n  + calcularEficiencia7030() : Decimal\n  + sellarRastroInmutable() : Booleano\n}\n\nclass AlertaOperativa &lt;&lt;entity&gt;&gt; #EDE9FE {\n  - codigoAlerta : Texto\n  - motivo : MotivoAlerta\n  - mensajeEjecutivoClaro : Texto\n  - estado : EstadoAlerta\n  - /suprimidaAntiSpam24h : Booleano\n  --\n  + evaluarUmbralEn200ms() : Booleano\n  + verificarSupresion24Horas() : Booleano\n  + marcarEstadoGestion() : EstadoAlerta\n}\n\nclass DespachoNotificacion &lt;&lt;entity&gt;&gt; #EDE9FE {\n  - codigoDespacho : Texto\n  - canal : CanalNotificacion\n  - destinatarioInstitucional : Texto\n  - cifradoTLSMinimo12 : Booleano = verdadero\n  - resultadoEntrega : Texto\n  --\n  + despacharCanalMensajeria() : Booleano\n  + escalarACorreoPorFallo() : Booleano\n  + registrarBitacora100PorCiento() : Vacio\n}\n\nclass UsuarioGestion &lt;&lt;entity&gt;&gt; #EDE9FE {\n  - usuarioInstitucional : Texto\n  - rolAutorizado : Texto\n  - vistaUnicaSoloLectura : Booleano = verdadero\n  - filtrosCombinadosActivos : Texto\n  - cierreSesionMenos200ms : Booleano = verdadero\n  --\n  + autenticarSesionTLS13() : Booleano\n  + consultarYFiltrarTablero() : Lista&lt;ExpedienteTrazabilidad&gt;\n  + gestionarAlertaOperativa() : Booleano\n}\n\nclass ReporteTrimestral &lt;&lt;entity&gt;&gt; #EDE9FE {\n  - codigoInforme : Texto\n  - periodoTrimestre : Texto\n  - totalProyectosPOA_REQ_INITI : Entero\n  - totalIncidentesGLPI : Entero\n  - /certificacionesATiempoVsAtrasadas : Texto\n  --\n  + consolidarMetricasTrimestre() : ReporteTrimestral\n  + exportarInformeEjecutivo() : Archivo\n}\n\n&#39; ============================================================================\n&#39; CATÁLOGO DE ENUMERACIONES DEL DOMINIO («enumeration»)\n&#39; ============================================================================\nenum ModuloCoreFinanciero {\n  FitSwitch\n  SWI\n  CanalesElectronicos\n  Credito\n  Antifraude\n  Nomina\n}\n\nenum EtapaOficial {\n  1_Analisis\n  2_Desarrollo\n  3_Certificacion\n  4_Despliegue\n  5_Estabilizacion\n}\n\nenum NivelComplejidad {\n  Baja_2pts\n  Media_5pts\n  Alta_13pts\n}\n\nenum NivelSemaforo {\n  Verde_Disponible\n  Amarillo_CargaOptima\n  Rojo_Sobreasignado\n}\n\nenum TipoCommit {\n  feat\n  fix\n  test\n  refactor\n}\n\nenum TipoEspecificacion {\n  REQ_Requerimiento\n  INI_TI_Iniciativa\n}\n\nenum EstadoAlerta {\n  Emitida\n  EnSeguimiento\n  Atendida\n  Suprimida24h\n}\n\nenum MotivoAlerta {\n  SobrecargaMayor40h\n  CertificacionMayor5Dias\n  RetornoPorFallo\n  IncidentePrioridad1\n  CambioPrioridadProyecto\n}\n\nenum CanalNotificacion {\n  CanalMensajeriaCorporativo\n  ServicioCorreoCorporativo\n}\n\nenum EstadoSincronizacion {\n  ConsolidadoCompleto\n  SincronizacionParcialSnapshot\n  TrabajoSinTrazabilidad\n  AbortadoPorRiesgoLOPDP\n}\n\n&#39; ============================================================================\n&#39; RELACIONES FORMALES UML 2.5.1 (FLUJO HORIZONTAL Y VERTICAL EQUILIBRADO)\n&#39; ============================================================================\n&#39; --- Banda Superior: Jerarquía POA/PETI + Desarrollador ---\nModuloFinanciero \&quot;1\&quot; o-right- \&quot;0..*\&quot; ProyectoPOA : agrupa\nProyectoPOA \&quot;1\&quot; *-right- \&quot;1..*\&quot; HistoriaSpec : compone\nHistoriaSpec -[hidden]right-&gt; Desarrollador\nHistoriaSpec \&quot;0..1\&quot; o-down- \&quot;0..*\&quot; TareaIssue : desglosa\n\n&#39; --- Banda Intermedia: Ejecución Técnica y Calidad ---\nDesarrollador \&quot;1\&quot; -down- \&quot;0..*\&quot; TareaIssue : rol: asignado Redmine\nDesarrollador \&quot;1..*\&quot; -down- \&quot;0..*\&quot; ActividadCodigo : rol: autor / QA (+2 h)\nDesarrollador \&quot;1\&quot; -down- \&quot;0..*\&quot; IncidenteSoporte : rol: soporte GLPI (4h/8h)\nTareaIssue \&quot;0..1\&quot; -right- \&quot;0..*\&quot; ActividadCodigo : respalda en código\\n(0 = RF-021)\nTareaIssue \&quot;0..1\&quot; -down- \&quot;0..1\&quot; IncidenteSoporte : espejo GLPI #ID\\n(0 = RF-022)\nActividadCodigo \&quot;1\&quot; *-down- \&quot;0..*\&quot; ReporteCalidad : inspecciona calidad\n\n&#39; --- Banda Media-Inferior: Consolidación, 5 Etapas y Eficiencia ---\nModuloFinanciero \&quot;1\&quot; -down- \&quot;0..*\&quot; ExpedienteTrazabilidad : organiza por módulo\nTareaIssue \&quot;1\&quot; -down- \&quot;1\&quot; ExpedienteTrazabilidad : consolida en expediente\nExpedienteTrazabilidad \&quot;1\&quot; *-down- \&quot;1..5\&quot; HitoEtapa : compone 5 etapas\nExpedienteTrazabilidad \&quot;1\&quot; *-down- \&quot;1..*\&quot; IndicadorDesempeno : sella cálculo 70/30\nHitoEtapa \&quot;1\&quot; -down- \&quot;0..*\&quot; RetornoFallo : registra retroceso\nRetornoFallo \&quot;0..*\&quot; -right- \&quot;1\&quot; IndicadorDesempeno : descuenta (-10 pts)\nReporteCalidad \&quot;0..*\&quot; -down- \&quot;1\&quot; IndicadorDesempeno : penaliza (-5 pts)\n\n&#39; --- Banda Inferior: Alertas, Tablero PMO y Reportes ---\nDesarrollador \&quot;0..1\&quot; -down- \&quot;0..*\&quot; AlertaOperativa : detona sobrecarga (&gt;40 h)\nHitoEtapa \&quot;0..1\&quot; -down- \&quot;0..*\&quot; AlertaOperativa : detona atraso / retorno\nAlertaOperativa \&quot;1\&quot; *-down- \&quot;1..*\&quot; DespachoNotificacion : audita envío (100%)\nUsuarioGestion \&quot;0..1\&quot; -down- \&quot;0..*\&quot; AlertaOperativa : gestiona (CU-07)\nUsuarioGestion \&quot;1\&quot; -up- \&quot;1..*\&quot; ExpedienteTrazabilidad : consulta / filtra (CU-04..06)\nUsuarioGestion \&quot;1\&quot; -down- \&quot;0..*\&quot; ReporteTrimestral : exporta informe (CU-08)\nIndicadorDesempeno \&quot;1..*\&quot; -down- \&quot;0..*\&quot; ReporteTrimestral : alimenta totales\n\n&#39; --- Ordenamiento limpio de las 10 Enumeraciones (2 filas x 5 columnas abajo) ---\nModuloCoreFinanciero -[hidden]right-&gt; EtapaOficial\nEtapaOficial -[hidden]right-&gt; NivelComplejidad\nNivelComplejidad -[hidden]right-&gt; NivelSemaforo\nNivelSemaforo -[hidden]right-&gt; TipoCommit\n\nTipoEspecificacion -[hidden]right-&gt; EstadoAlerta\nEstadoAlerta -[hidden]right-&gt; MotivoAlerta\nMotivoAlerta -[hidden]right-&gt; CanalNotificacion\nCanalNotificacion -[hidden]right-&gt; EstadoSincronizacion\n\nModuloCoreFinanciero -[hidden]down-&gt; TipoEspecificacion\nEtapaOficial -[hidden]down-&gt; EstadoAlerta\nNivelComplejidad -[hidden]down-&gt; MotivoAlerta\nNivelSemaforo -[hidden]down-&gt; CanalNotificacion\nTipoCommit -[hidden]down-&gt; EstadoSincronizacion\n\nDespachoNotificacion -[hidden]down-&gt; CanalNotificacion\nReporteTrimestral -[hidden]down-&gt; ModuloCoreFinanciero\n\nfooter Vista Lógica UML 2.5.1 — Diagrama de Clases Unificado sin Paquetes (sincronizado 1:1 con Diseño Detallado y Vista de Procesos)\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Hnr8xw7pf5AGJRz4jz__-1">
